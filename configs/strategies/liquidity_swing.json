{
  "strategies": {
    "liquidity_swing": {
      "class": "swing_trader.core.strategies.LiquiditySwingStrategy",
      "description": "Liquidity-based swing trading using operator psychology",
      "params": {
        "equal_level_tolerance": {
          "type": "float",
          "low": 0.002,
          "high": 0.006,
          "step": 0.0005,
          "description": "Price tolerance for equal level clustering (0.2-0.6%)"
        },
        "compression_threshold": {
          "type": "float",
          "low": 0.65,
          "high": 0.85,
          "step": 0.05,
          "description": "ATR contraction ratio threshold"
        },
        "volume_spike_min": {
          "type": "float",
          "low": 1.2,
          "high": 2.0,
          "step": 0.1,
          "description": "Minimum volume ratio for sweep confirmation"
        },
        "min_reward_risk": {
          "type": "float",
          "low": 1.5,
          "high": 3.0,
          "step": 0.25,
          "description": "Minimum reward-to-risk ratio"
        },
        "swing_order": {
          "type": "int",
          "low": 2,
          "high": 5,
          "step": 1,
          "description": "Bars on each side for swing detection"
        },
        "reclaim_strength_min": {
          "type": "float",
          "low": 0.4,
          "high": 0.75,
          "step": 0.05,
          "description": "Minimum candle body strength for reclaim"
        }
      },
      "default_params": {
        "equal_level_tolerance": 0.003,
        "compression_threshold": 0.75,
        "volume_spike_min": 1.5,
        "min_reward_risk": 2.0,
        "stop_buffer_pct": 0.01,
        "target_range_pct": 1.0,
        "swing_order": 3,
        "compression_window": 10,
        "volume_lookback": 20,
        "reclaim_strength_min": 0.6
      },
      "optimization_metric": "sharpe",
      "alternative_metrics": ["total_return", "max_drawdown"]
    }
  },
  "backtest_settings": {
    "initial_cash": 1000000,
    "transaction_fee": 0.001,
    "slippage": 0.002
  },
  "optimization_settings": {
    "n_trials": 100,
    "timeout": 3600,
    "n_jobs": -1
  }
}
